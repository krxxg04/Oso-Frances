---
---

<div class="simulador">
  <header class="section-header">
    <div>
      <p class="eyebrow">Simulador</p>
      <h2 class="section-title">Crédito vehicular</h2>
      <p class="section-subtitle">Entradas, cálculo y salida completa</p>
    </div>
    <span class="chip">TCEA · VAN · TIR</span>
  </header>

  <p id="simulador-error" class="alert hidden"></p>
  <p id="simulador-ok" class="alert hidden"></p>

  <form id="simulador-form" class="form-stack">
    <section class="card">
      <div class="card-header">
        <div>
          <h3 class="card-title">Vehículo</h3>
          <p class="card-subtitle">Registrar o usar datos manuales</p>
        </div>
      </div>

      <div class="form-grid">
        <div class="field">
          <label for="vehiculoId" class="field-label">Vehículo guardado (opcional)</label>
          <select id="vehiculoId" name="vehiculoId" class="ios-input">
            <option value="">No usar vehículo guardado</option>
          </select>
        </div>
        <div class="field">
          <label for="marca" class="field-label">Marca</label>
          <input id="marca" name="marca" type="text" class="ios-input" required />
        </div>
        <div class="field">
          <label for="modelo" class="field-label">Modelo</label>
          <input id="modelo" name="modelo" type="text" class="ios-input" required />
        </div>
        <div class="field">
          <label for="anio" class="field-label">Año</label>
          <input id="anio" name="anio" type="number" min="2000" step="1" class="ios-input" required />
        </div>
        <div class="field">
          <label for="tipo" class="field-label">Tipo</label>
          <input id="tipo" name="tipo" type="text" class="ios-input" value="sedan" required />
        </div>
      </div>

      <div class="card-footer">
        <button type="button" id="btn-registrar-vehiculo" class="btn-primary">Registrar vehículo</button>
      </div>
    </section>

    <section class="card">
      <div class="card-header">
        <div>
          <h3 class="card-title">Crédito</h3>
          <p class="card-subtitle">Banco, tasa, seguros y condiciones</p>
        </div>
      </div>

      <div class="form-grid">
        <div class="field">
          <label for="moneda" class="field-label">Moneda</label>
          <select id="moneda" name="moneda" class="ios-input">
            <option value="PEN">PEN</option>
            <option value="USD">USD</option>
          </select>
        </div>

        <div class="field">
          <label for="precioVehiculo" class="field-label">Precio del vehículo</label>
          <input id="precioVehiculo" name="precioVehiculo" type="number" min="0" step="0.01" class="ios-input" required />
        </div>

        <div class="field">
          <label for="bancoId" class="field-label">Banco</label>
          <select id="bancoId" name="bancoId" class="ios-input">
            <option value="">Sin banco (manual)</option>
          </select>
        </div>

        <div class="field">
          <label for="porcentajeCuotaInicial" class="field-label">Cuota inicial (%)</label>
          <input id="porcentajeCuotaInicial" name="porcentajeCuotaInicial" type="number" min="0" max="100" step="0.01" class="ios-input" required />
        </div>

        <div class="field">
          <label for="plazoMeses" class="field-label">Plazo (meses)</label>
          <select id="plazoMeses" name="plazoMeses" class="ios-input" required>
            <option value="12">12</option>
            <option value="24">24</option>
            <option value="36">36</option>
            <option value="48">48</option>
            <option value="60">60</option>
          </select>
        </div>

        <div class="field">
          <label for="tipoGracia" class="field-label">Periodo de gracia</label>
          <select id="tipoGracia" name="tipoGracia" class="ios-input" required>
            <option value="sin_gracia">Sin gracia</option>
            <option value="parcial">Gracia parcial</option>
            <option value="total">Gracia total</option>
          </select>
        </div>

        <div class="field">
          <label for="periodosGracia" class="field-label">Número de periodos de gracia</label>
          <input id="periodosGracia" name="periodosGracia" type="number" min="0" step="1" class="ios-input" value="0" required />
        </div>

        <div class="field">
          <label for="cuotaFinalBalloon" class="field-label">Cuota final balloon</label>
          <input id="cuotaFinalBalloon" name="cuotaFinalBalloon" type="number" min="0" step="0.01" class="ios-input" value="0" required />
        </div>

        <div class="field">
          <label for="seguroVehicularMensual" class="field-label">Seguro vehicular mensual</label>
          <input id="seguroVehicularMensual" name="seguroVehicularMensual" type="number" min="0" step="0.01" class="ios-input" value="0" required />
        </div>

        <div class="field">
          <label for="fechaInicio" class="field-label">Fecha de inicio</label>
          <input id="fechaInicio" name="fechaInicio" type="date" class="ios-input" required />
        </div>
      </div>

      <div id="banco-info" class="card hidden">
        <p class="card-subtitle" id="banco-info-text"></p>
      </div>

      <div id="manual-rate-fields" class="form-grid">
        <div class="field">
          <label for="tipoTasa" class="field-label">Tipo de tasa</label>
          <select id="tipoTasa" name="tipoTasa" class="ios-input">
            <option value="efectiva">Efectiva</option>
            <option value="nominal">Nominal</option>
          </select>
        </div>
        <div class="field">
          <label for="tasaAnual" class="field-label">Tasa anual (%)</label>
          <input id="tasaAnual" name="tasaAnual" type="number" min="0" max="100" step="0.0001" class="ios-input" />
        </div>
        <div class="field">
          <label for="tasaEfectivaAnual" class="field-label">Tasa efectiva anual (%)</label>
          <input id="tasaEfectivaAnual" name="tasaEfectivaAnual" type="number" min="0" max="100" step="0.0001" class="ios-input" />
        </div>
        <div class="field" id="frecuencia-wrap">
          <label for="frecuenciaCapitalizacion" class="field-label">Frecuencia de capitalización</label>
          <input id="frecuenciaCapitalizacion" name="frecuenciaCapitalizacion" type="number" min="1" step="1" class="ios-input" value="12" />
        </div>
        <div class="field">
          <label for="seguroDesgravamenAnual" class="field-label">Seguro de desgravamen anual (%)</label>
          <input id="seguroDesgravamenAnual" name="seguroDesgravamenAnual" type="number" min="0" max="100" step="0.0001" class="ios-input" />
        </div>
      </div>

      <div class="card-footer">
        <button type="submit" id="btn-calcular" class="btn-primary">Simular crédito</button>
      </div>
    </section>
  </form>

  <section class="results">
    <header class="section-header">
      <div>
        <p class="eyebrow">Resultado</p>
        <h3 class="section-title">Resumen financiero</h3>
      </div>
      <span class="chip">Salida</span>
    </header>

    <div class="stats-grid results-stats" id="resumen-grid"></div>

    <div class="card hidden" id="banco-result-card">
      <h3 class="card-title">Datos del banco</h3>
      <p id="banco-resultado"></p>
    </div>

    <div class="card table-card results-table-card">
      <div class="table-scroll">
        <table class="results-table">
          <thead>
            <tr>
              <th>Mes</th>
              <th>Fecha</th>
              <th>Saldo Inicial</th>
              <th>Cuota</th>
              <th>Capital + Interés</th>
              <th>Interés</th>
              <th>Seguro Vehicular</th>
              <th>Seguro Desgravamen</th>
              <th>Seguro</th>
              <th>Amortización</th>
              <th>Saldo Final</th>
              <th>Tipo Gracia</th>
            </tr>
          </thead>
          <tbody id="cronograma-body"></tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="card">
    <div class="card-header">
      <div>
        <h3 class="card-title">Historial de simulaciones</h3>
        <p class="card-subtitle">Filtros y detalle</p>
      </div>
    </div>

    <form id="historial-filtros" class="form-grid">
      <input id="f-moneda" class="ios-input" placeholder="Moneda (PEN/USD)" />
      <input id="f-plazo" class="ios-input" type="number" placeholder="Plazo meses" />
      <input id="f-vehiculo" class="ios-input" placeholder="Vehículo" />
      <input id="f-monto-min" class="ios-input" type="number" placeholder="Monto mínimo" />
      <input id="f-monto-max" class="ios-input" type="number" placeholder="Monto máximo" />
      <input id="f-fecha-desde" class="ios-input" type="date" />
      <input id="f-fecha-hasta" class="ios-input" type="date" />
      <button class="btn-primary" type="submit">Filtrar historial</button>
    </form>

    <div class="table-scroll" style="margin-top: 16px;">
      <table class="results-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Banco</th>
            <th>TCEA</th>
            <th>Total Pagado</th>
            <th>Acción</th>
          </tr>
        </thead>
        <tbody id="historial-body"></tbody>
      </table>
    </div>
  </section>
</div>

<script>
  import initSimuladorCredito from '../scripts/simuladorCredito';
  initSimuladorCredito();
</script>
