---
---

<div class="container mx-auto p-4">
  <h1 class="text-2xl font-bold text-center text-blue-600">
    Simulador de Crédito Vehicular
  </h1>

  <form id="simulador-form" class="bg-white p-6 rounded shadow-md space-y-4">
    <div>
      <label for="nombre" class="block text-sm font-medium">Nombre del Cliente</label>
      <input id="nombre" name="nombre" type="text" class="w-full border rounded p-2" />
    </div>

    <div>
      <label for="precioVehiculo" class="block text-sm font-medium">Precio del Vehículo</label>
      <input
        id="precioVehiculo"
        name="precioVehiculo"
        type="number"
        min="0"
        step="0.01"
        required
        class="w-full border rounded p-2"
      />
    </div>

    <div>
      <label for="cuotaInicial" class="block text-sm font-medium">Porcentaje de Cuota Inicial (%)</label>
      <input
        id="cuotaInicial"
        name="cuotaInicial"
        type="number"
        min="0"
        max="100"
        step="0.01"
        required
        class="w-full border rounded p-2"
      />
    </div>

    <div>
      <label for="plazo" class="block text-sm font-medium">Plazo (meses)</label>
      <input
        id="plazo"
        name="plazo"
        type="number"
        min="1"
        step="1"
        required
        class="w-full border rounded p-2"
      />
    </div>

    <div>
      <label for="tasaNominal" class="block text-sm font-medium">Tasa Nominal (TN)</label>
      <input
        id="tasaNominal"
        name="tasaNominal"
        type="number"
        min="0"
        step="0.0001"
        required
        class="w-full border rounded p-2"
      />
    </div>

    <div>
      <label for="frecuenciaCapitalizacion" class="block text-sm font-medium">Frecuencia de Capitalización (m)</label>
      <input
        id="frecuenciaCapitalizacion"
        name="frecuenciaCapitalizacion"
        type="number"
        min="1"
        step="1"
        required
        class="w-full border rounded p-2"
      />
    </div>

    <div>
      <label for="periodosGracia" class="block text-sm font-medium">Periodos de Gracia</label>
      <input
        id="periodosGracia"
        name="periodosGracia"
        type="number"
        min="0"
        step="1"
        required
        class="w-full border rounded p-2"
      />
    </div>

    <div>
      <label for="tipoGracia" class="block text-sm font-medium">Tipo de Gracia</label>
      <select id="tipoGracia" name="tipoGracia" class="w-full border rounded p-2">
        <option value="total">Total</option>
        <option value="parcial">Parcial</option>
      </select>
    </div>

    <button type="submit" id="btn-calcular" class="bg-blue-600 text-white px-4 py-2 rounded">
      Calcular
    </button>
  </form>

  <div class="mt-6">
    <h2 class="text-xl font-bold text-blue-600">Resultados</h2>
    <table class="table-auto w-full border-collapse border border-gray-300">
      <thead>
        <tr>
          <th class="border border-gray-300 px-4 py-2">Mes</th>
          <th class="border border-gray-300 px-4 py-2">Cuota</th>
          <th class="border border-gray-300 px-4 py-2">Interés</th>
          <th class="border border-gray-300 px-4 py-2">Amortización</th>
          <th class="border border-gray-300 px-4 py-2">Saldo Deudor</th>
        </tr>
      </thead>
      <tbody id="cronograma-body"></tbody>
    </table>

    <div class="mt-4">
      <p><strong>VAN:</strong> <span id="valor-van">0.00</span></p>
      <p><strong>TIR:</strong> <span id="valor-tir">0.00%</span></p>
    </div>
  </div>
</div>

<script lang="ts">
  import { calcularTIR, calcularVAN, generarCronograma, type Pago } from '../utils/finance';

  type TipoGracia = 'total' | 'parcial';

  const getEl = <T extends HTMLElement>(id: string): T => {
    const element = document.getElementById(id);
    if (!element) throw new Error(`No se encontró el elemento #${id}`);
    return element as T;
  };

  const form = getEl<HTMLFormElement>('simulador-form');

  const precioVehiculoEl = getEl<HTMLInputElement>('precioVehiculo');
  const cuotaInicialEl = getEl<HTMLInputElement>('cuotaInicial');
  const plazoEl = getEl<HTMLInputElement>('plazo');
  const tasaNominalEl = getEl<HTMLInputElement>('tasaNominal');
  const frecuenciaCapitalizacionEl = getEl<HTMLInputElement>('frecuenciaCapitalizacion');
  const periodosGraciaEl = getEl<HTMLInputElement>('periodosGracia');
  const tipoGraciaEl = getEl<HTMLSelectElement>('tipoGracia');

  const cronogramaBodyEl = getEl<HTMLTableSectionElement>('cronograma-body');
  const vanEl = getEl<HTMLSpanElement>('valor-van');
  const tirEl = getEl<HTMLSpanElement>('valor-tir');

  const toNumber = (input: HTMLInputElement): number => {
    const value = Number(input.value);
    return Number.isFinite(value) ? value : 0;
  };

  const format = (n: number): string => n.toFixed(2);

  const renderCronograma = (cronograma: Pago[]) => {
    cronogramaBodyEl.innerHTML = cronograma
      .map(
        (pago) => `
          <tr>
            <td class="border border-gray-300 px-4 py-2">${pago.mes}</td>
            <td class="border border-gray-300 px-4 py-2">${format(pago.cuota)}</td>
            <td class="border border-gray-300 px-4 py-2">${format(pago.interes)}</td>
            <td class="border border-gray-300 px-4 py-2">${format(pago.amortizacion)}</td>
            <td class="border border-gray-300 px-4 py-2">${format(pago.saldoDeudor)}</td>
          </tr>
        `
      )
      .join('');
  };

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const precioVehiculo = toNumber(precioVehiculoEl);
    const cuotaInicial = toNumber(cuotaInicialEl);
    const plazo = toNumber(plazoEl);
    const tasaNominal = toNumber(tasaNominalEl);
    const frecuenciaCapitalizacion = toNumber(frecuenciaCapitalizacionEl);
    const periodosGracia = toNumber(periodosGraciaEl);
    const tipoGracia = tipoGraciaEl.value as TipoGracia;

    if (frecuenciaCapitalizacion <= 0) return;

    const capital = precioVehiculo - precioVehiculo * (cuotaInicial / 100);
    const cronograma = generarCronograma(
      capital,
      tasaNominal,
      frecuenciaCapitalizacion,
      plazo,
      periodosGracia,
      tipoGracia
    );

    renderCronograma(cronograma);

    const flujos = cronograma.map((pago) => -pago.cuota);
    if (flujos.length > 0) {
      flujos[0] += precioVehiculo * (cuotaInicial / 100);
    }

    const tasaPeriodo = tasaNominal / frecuenciaCapitalizacion;
    const van = calcularVAN(tasaPeriodo, flujos);
    const tir = calcularTIR(flujos);

    vanEl.textContent = format(van);
    tirEl.textContent = `${(tir * 100).toFixed(2)}%`;
  });
</script>