---
---

<div class="simulador">
  <header class="section-header">
    <div>
      <p class="eyebrow">Simulador</p>
      <h2 class="section-title">Crédito vehicular</h2>
      <p class="section-subtitle">Método Francés · Cronograma y métricas</p>
    </div>
    <span class="chip">Compra inteligente</span>
  </header>

  <form id="simulador-form" class="form-stack">
    <section class="card">
      <div class="card-header">
        <div>
          <h3 class="card-title">Datos del cliente</h3>
          <p class="card-subtitle">Identificación básica</p>
        </div>
      </div>
      <div class="form-grid">
        <div class="field">
          <label for="nombre" class="field-label">Nombre del cliente</label>
          <input id="nombre" name="nombre" type="text" required class="ios-input" />
        </div>
      </div>
    </section>

    <section class="card">
      <div class="card-header">
        <div>
          <h3 class="card-title">Condiciones del crédito</h3>
          <p class="card-subtitle">Monto, tasa y plazo</p>
        </div>
      </div>
      <div class="form-grid">
        <div class="field">
          <label for="precioVehiculo" class="field-label">Precio del vehículo</label>
          <input
            id="precioVehiculo"
            name="precioVehiculo"
            type="number"
            min="0"
            step="0.01"
            required
            class="ios-input"
          />
        </div>

        <div class="field">
          <label for="cuotaInicial" class="field-label">Cuota inicial (%)</label>
          <input
            id="cuotaInicial"
            name="cuotaInicial"
            type="number"
            min="0"
            max="100"
            step="0.01"
            required
            class="ios-input"
          />
        </div>

        <div class="field">
          <label for="plazo" class="field-label">Plazo (meses)</label>
          <input id="plazo" name="plazo" type="number" min="1" step="1" required class="ios-input" />
        </div>

        <div class="field">
          <label for="banco" class="field-label">Banco</label>
          <select id="banco" name="banco" class="ios-input" required>
            <option value="bbva">BBVA</option>
            <option value="bcp">BCP</option>
            <option value="interbank">Interbank</option>
            <option value="scotiabank">Scotiabank</option>
          </select>
        </div>

        <div class="field">
          <label for="tasaEfectivaAnual" class="field-label">Tasa efectiva anual (TEA %)</label>
          <input
            id="tasaEfectivaAnual"
            name="tasaEfectivaAnual"
            type="number"
            min="0"
            max="40"
            step="0.0001"
            value="14"
            required
            class="ios-input"
          />
        </div>

        <div class="field">
          <label for="seguroDesgravamen" class="field-label">Seguro de desgravamen mensual (%)</label>
          <input
            id="seguroDesgravamen"
            name="seguroDesgravamen"
            type="number"
            min="0"
            max="5"
            step="0.0001"
            value="0.01"
            required
            class="ios-input"
          />
        </div>
      </div>
    </section>

    <section class="card">
      <div class="card-header">
        <div>
          <h3 class="card-title">Períodos de gracia</h3>
          <p class="card-subtitle">Opciones de diferimiento</p>
        </div>
      </div>
      <div class="form-grid">
        <div class="field">
          <label for="periodosGracia" class="field-label">Períodos de gracia</label>
          <input
            id="periodosGracia"
            name="periodosGracia"
            type="number"
            min="0"
            step="1"
            required
            class="ios-input"
          />
        </div>

        <div class="field">
          <label for="tipoGracia" class="field-label">Tipo de gracia</label>
          <select id="tipoGracia" name="tipoGracia" class="ios-input">
            <option value="sin_gracia">Sin período de gracia</option>
            <option value="total">Total</option>
            <option value="parcial">Parcial</option>
          </select>
        </div>
      </div>
      <div class="card-footer">
        <button type="submit" id="btn-calcular" class="btn-primary">Calcular</button>
      </div>
    </section>
  </form>

  <section class="results">
    <header class="section-header">
      <div>
        <p class="eyebrow">Resultados</p>
        <h3 class="section-title">Cronograma</h3>
        <p class="section-subtitle">Detalle de cuotas y saldos</p>
      </div>
      <span class="chip">VAN &amp; TIR</span>
    </header>

    <div class="card table-card results-table-card">
      <div class="table-scroll">
        <table class="results-table">
          <thead>
            <tr>
              <th>Mes</th>
              <th>Cuota</th>
              <th>Interés</th>
              <th>Amortización</th>
              <th>Saldo Deudor</th>
            </tr>
          </thead>
          <tbody id="cronograma-body"></tbody>
        </table>
      </div>
    </div>

    <div class="stats-grid results-stats">
      <div class="stat-card">
        <p class="stat-label">VAN</p>
        <p class="stat-value"><span id="valor-van">0.00</span></p>
      </div>
      <div class="stat-card">
        <p class="stat-label">TIR</p>
        <p class="stat-value"><span id="valor-tir">0.00%</span></p>
      </div>
    </div>
  </section>
</div>

<script>
  import initSimuladorCredito from '../scripts/simuladorCredito';
  initSimuladorCredito();
</script>
