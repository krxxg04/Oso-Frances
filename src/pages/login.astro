---
import Layout from '../layouts/Layout.astro';
import bootstrapLoginUrl from '../scripts/bootstrapLogin.ts?url';

const apiBaseUrl =
  (import.meta.env.VITE_API_URL as string | undefined)?.trim() ||
  (import.meta.env.PUBLIC_API_BASE_URL as string | undefined)?.trim() ||
  'https://backend-oso-frances.onrender.com';
const googleLoginUrl = `${apiBaseUrl}/api/v1/auth/google/login`;
---

<Layout title="Acceso">
  <main class="page-center">
    <section class="login-card">
      <img src="/Whiteosito.png" alt="El Oso Frances" class="login-logo" loading="eager" />
      <p class="eyebrow login-eyebrow">El Oso Frances</p>
      <h1 class="login-title">Acceso seguro</h1>
      <p id="login-subtitle" class="login-subtitle">Inicia sesion para continuar con el simulador.</p>

      <form id="login-form" class="form-stack">
        <h2 class="auth-section-title">Iniciar sesion</h2>
        <p id="auth-status" class="alert hidden"></p>
        <a id="login-google" href={googleLoginUrl} class="social-btn social-btn-google">
          <span class="social-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="google-icon" role="img">
              <path
                fill="#EA4335"
                d="M12 10.2v3.9h5.4c-.2 1.3-1.5 3.9-5.4 3.9-3.2 0-5.9-2.7-5.9-6s2.7-6 5.9-6c1.8 0 3 .8 3.7 1.5l2.5-2.4C16.6 3.5 14.5 2.5 12 2.5 6.8 2.5 2.5 6.7 2.5 12s4.3 9.5 9.5 9.5c5.5 0 9.1-3.9 9.1-9.3 0-.6-.1-1.1-.2-1.6H12Z"
              ></path>
              <path
                fill="#34A853"
                d="M2.5 12c0 1.7.4 3.2 1.2 4.6l3-2.3c-.2-.6-.4-1.4-.4-2.3s.1-1.6.4-2.3l-3-2.3C2.9 8.8 2.5 10.3 2.5 12Z"
              ></path>
              <path
                fill="#FBBC05"
                d="M12 21.5c2.6 0 4.8-.9 6.4-2.4l-3.1-2.4c-.8.6-1.9 1.1-3.3 1.1-2.5 0-4.7-1.7-5.5-4.1l-3.1 2.4c1.6 3.2 4.9 5.4 8.6 5.4Z"
              ></path>
              <path
                fill="#4285F4"
                d="M21.1 12.2c0-.7-.1-1.3-.2-2H12v3.9h5.4c-.3 1.4-1.1 2.5-2.2 3.3l3.1 2.4c1.8-1.7 2.8-4.1 2.8-7.6Z"
              ></path>
            </svg>
          </span>
          <span>Continuar con Google</span>
        </a>
        <div class="auth-divider" aria-hidden="true"></div>
        <div class="field">
          <label for="login-username" class="field-label">Usuario</label>
          <input id="login-username" name="username" type="text" required autocomplete="username" class="ios-input" />
        </div>

        <div class="field">
          <label for="login-password" class="field-label">Contrasena</label>
          <input id="login-password" name="password" type="password" required autocomplete="current-password" class="ios-input" />
        </div>

        <p id="login-error" class="alert hidden"></p>
        <button type="submit" class="btn-primary">Ingresar</button>
        <p class="auth-switch">
          No tienes cuenta?
          <button id="go-register" type="button" class="auth-switch-link">Crear cuenta</button>
        </p>
      </form>

      <form id="register-form" class="form-stack hidden">
        <h2 class="auth-section-title">Crear cuenta</h2>
        <div class="field">
          <label for="register-dni" class="field-label">DNI</label>
          <input id="register-dni" name="dni" type="text" required inputmode="numeric" pattern="[0-9]{8}" maxlength="8" class="ios-input" />
        </div>
        <div class="field">
          <label for="register-full-name" class="field-label">Nombre completo</label>
          <input id="register-full-name" name="fullName" type="text" required autocomplete="name" class="ios-input" />
        </div>
        <div class="field">
          <label for="register-username" class="field-label">Usuario</label>
          <input id="register-username" name="username" type="text" required autocomplete="username" class="ios-input" />
        </div>
        <div class="field">
          <label for="register-email" class="field-label">Gmail</label>
          <input id="register-email" name="email" type="email" required autocomplete="email" class="ios-input" />
        </div>

        <div class="field">
          <label for="register-password" class="field-label">Contrasena</label>
          <input id="register-password" name="password" type="password" required autocomplete="new-password" class="ios-input" />
        </div>

        <div class="field">
          <label for="register-password-confirm" class="field-label">Confirmar contrasena</label>
          <input id="register-password-confirm" name="passwordConfirm" type="password" required autocomplete="new-password" class="ios-input" />
        </div>

        <p id="register-error" class="alert hidden"></p>
        <p id="register-success" class="alert hidden"></p>
        <button type="submit" class="btn-primary">Crear cuenta</button>
        <p class="auth-switch">
          Ya tienes cuenta?
          <button id="go-login" type="button" class="auth-switch-link">Iniciar sesion</button>
        </p>
      </form>
    </section>
  </main>
</Layout>

<script type="module" src={bootstrapLoginUrl}></script>
