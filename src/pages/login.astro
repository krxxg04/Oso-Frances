---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Login">
	<main class="page-center">
		<section class="login-card">
			<img src="/Whiteosito.png" alt="El Oso Francés" class="login-logo" loading="eager" />
			<p class="eyebrow login-eyebrow">El Oso Francés</p>
			<h1 class="login-title">Acceso seguro</h1>
			<p class="login-subtitle">Valida tu identidad para continuar con el simulador.</p>

			<form id="login-form" class="form-stack">
				<div class="field">
					<label for="username" class="field-label">Usuario</label>
					<input
						id="username"
						name="username"
						type="text"
						required
						autocomplete="username"
						class="ios-input"
					/>
				</div>

				<div class="field">
					<label for="password" class="field-label">Contraseña</label>
					<input
						id="password"
						name="password"
						type="password"
						required
						autocomplete="current-password"
						class="ios-input"
					/>
				</div>

				<p id="login-error" class="alert hidden"></p>

				<button type="submit" class="btn-primary">Ingresar</button>

				<p class="helper">
					Demos: <strong>admin/admin</strong> o <strong>user/user</strong>
				</p>
			</form>
		</section>
	</main>
</Layout>

<script>
	import initLogin from '../scripts/login';
	initLogin();
</script>
