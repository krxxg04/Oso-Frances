---
import Layout from '../layouts/Layout.astro';
import SimuladorCredito from '../components/SimuladorCredito.astro';

const saldo = 'S/ 12,450.90';
const acciones = [
  { label: 'Transferir', href: '#simulador' },
  { label: 'Pagar', href: '#simulador' },
  { label: 'Recargar', href: '#simulador' },
  { label: 'Movimientos', href: '#movimientos' },
];

const movimientos = [
  { concepto: 'Supermercado', fecha: '30 Abr', monto: '- S/ 124.80' },
  { concepto: 'Gasolina', fecha: '29 Abr', monto: '- S/ 80.00' },
  { concepto: 'Transferencia recibida', fecha: '28 Abr', monto: 'S/ 500.00' },
  { concepto: 'Suscripción', fecha: '27 Abr', monto: '- S/ 29.90' },
  { concepto: 'Restaurante', fecha: '26 Abr', monto: '- S/ 56.40' },
  { concepto: 'Farmacia', fecha: '25 Abr', monto: '- S/ 18.20' },
];
---

<Layout title="Dashboard">
  <main class="mx-auto w-full max-w-md px-4 py-6">
    <header class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <img
          src="/Whiteosito.png"
          alt="Oso Frances"
          class="h-10 w-10 rounded-lg border border-gray-200"
          loading="eager"
        />
        <div class="leading-tight">
          <p class="text-[11px] text-gray-500">Oso Frances</p>
          <h1 class="text-base font-semibold tracking-tight text-black">Dashboard</h1>
        </div>
      </div>

      <a
        href="#movimientos"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-gray-200 text-gray-900 hover:bg-gray-50"
        aria-label="Ir a movimientos"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 12h18" />
          <path d="M3 6h18" />
          <path d="M3 18h18" />
        </svg>
      </a>
    </header>

    <section class="mt-6">
      <div class="rounded-xl border border-gray-200 p-5">
        <p class="text-xs text-gray-500">Saldo disponible</p>
        <p class="mt-2 text-4xl font-semibold tracking-tight text-black tabular-nums">{saldo}</p>
        <p class="mt-1 text-xs text-gray-500">Actualizado hoy</p>
      </div>
    </section>

    <section class="mt-5">
      <p class="text-xs text-gray-500">Acciones rápidas</p>
      <div class="mt-3 grid grid-cols-4 gap-2">
        {acciones.map((a) => (
          <a
            href={a.href}
            class="flex flex-col items-center justify-center gap-2 rounded-xl border border-gray-200 px-2 py-3 text-center hover:bg-gray-50"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 5v14" />
              <path d="M5 12h14" />
            </svg>
            <span class="text-[11px] font-medium text-gray-900">{a.label}</span>
          </a>
        ))}
      </div>
    </section>

    <section id="movimientos" class="mt-7 scroll-mt-6">
      <div class="flex items-end justify-between">
        <h2 class="text-sm font-semibold tracking-tight text-black">Movimientos recientes</h2>
        <p class="text-xs text-gray-500">Últimos 7 días</p>
      </div>
      <ul class="mt-3 overflow-hidden rounded-xl border border-gray-200 divide-y divide-gray-100">
        {movimientos.map((m) => (
          <li class="flex items-center justify-between gap-4 px-4 py-3">
            <div class="min-w-0">
              <p class="truncate text-sm font-medium text-gray-900">{m.concepto}</p>
              <p class="mt-0.5 text-xs text-gray-500">{m.fecha}</p>
            </div>
            <p class="shrink-0 text-sm font-semibold text-black tabular-nums">{m.monto}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="simulador" class="mt-10 scroll-mt-6">
      <SimuladorCredito />
    </section>
  </main>
</Layout>