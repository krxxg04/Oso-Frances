---
import { useState } from 'react';
import { calcularValorFuturo, calcularValorPresente, calcularCuotaFija, generarCronograma, calcularVAN, calcularTIR } from '../utils/finance';

const [formData, setFormData] = useState({
  nombre: '',
  precioVehiculo: 0,
  cuotaInicial: 0,
  plazo: 0,
  tasaNominal: 0,
  frecuenciaCapitalizacion: 0,
  periodosGracia: 0,
  tipoGracia: 'total',
});

const [cronograma, setCronograma] = useState([]);
const [indicadores, setIndicadores] = useState({ van: 0, tir: 0 });

function handleInputChange(event) {
  const { name, value } = event.target;
  setFormData({ ...formData, [name]: parseFloat(value) || value });
}

function calcular() {
  const { precioVehiculo, cuotaInicial, plazo, tasaNominal, frecuenciaCapitalizacion, periodosGracia, tipoGracia } = formData;
  const capital = precioVehiculo - (precioVehiculo * (cuotaInicial / 100));
  const cronogramaCalculado = generarCronograma(capital, tasaNominal, frecuenciaCapitalizacion, plazo, periodosGracia, tipoGracia);

  const flujos = cronogramaCalculado.map((pago) => -pago.cuota);
  flujos[0] += precioVehiculo * (cuotaInicial / 100);

  const van = calcularVAN(tasaNominal / frecuenciaCapitalizacion, flujos);
  const tir = calcularTIR(flujos);

  setCronograma(cronogramaCalculado);
  setIndicadores({ van, tir });
}
---

<html>
  <head>
    <title>Crédito Vehicular - Método Francés</title>
  </head>
  <body class="bg-blue-50 text-gray-800">
    <div class="container mx-auto p-4">
      <h1 class="text-2xl font-bold text-center text-blue-600">Simulador de Crédito Vehicular</h1>

      <form class="bg-white p-6 rounded shadow-md space-y-4">
        <div>
          <label class="block text-sm font-medium">Nombre del Cliente</label>
          <input type="text" name="nombre" class="w-full border rounded p-2" onInput={handleInputChange} />
        </div>
        <div>
          <label class="block text-sm font-medium">Precio del Vehículo</label>
          <input type="number" name="precioVehiculo" class="w-full border rounded p-2" onInput={handleInputChange} />
        </div>
        <div>
          <label class="block text-sm font-medium">Porcentaje de Cuota Inicial</label>
          <input type="number" name="cuotaInicial" class="w-full border rounded p-2" onInput={handleInputChange} />
        </div>
        <div>
          <label class="block text-sm font-medium">Plazo (meses)</label>
          <input type="number" name="plazo" class="w-full border rounded p-2" onInput={handleInputChange} />
        </div>
        <div>
          <label class="block text-sm font-medium">Tasa Nominal (TN)</label>
          <input type="number" name="tasaNominal" class="w-full border rounded p-2" onInput={handleInputChange} />
        </div>
        <div>
          <label class="block text-sm font-medium">Frecuencia de Capitalización (m)</label>
          <input type="number" name="frecuenciaCapitalizacion" class="w-full border rounded p-2" onInput={handleInputChange} />
        </div>
        <div>
          <label class="block text-sm font-medium">Periodos de Gracia</label>
          <input type="number" name="periodosGracia" class="w-full border rounded p-2" onInput={handleInputChange} />
        </div>
        <div>
          <label class="block text-sm font-medium">Tipo de Gracia</label>
          <select name="tipoGracia" class="w-full border rounded p-2" onInput={handleInputChange}>
            <option value="total">Total</option>
            <option value="parcial">Parcial</option>
          </select>
        </div>
        <button type="button" class="bg-blue-600 text-white px-4 py-2 rounded" onClick={calcular}>Calcular</button>
      </form>

      <div class="mt-6">
        <h2 class="text-xl font-bold text-blue-600">Resultados</h2>
        <table class="table-auto w-full border-collapse border border-gray-300">
          <thead>
            <tr>
              <th class="border border-gray-300 px-4 py-2">Mes</th>
              <th class="border border-gray-300 px-4 py-2">Cuota</th>
              <th class="border border-gray-300 px-4 py-2">Interés</th>
              <th class="border border-gray-300 px-4 py-2">Amortización</th>
              <th class="border border-gray-300 px-4 py-2">Saldo Deudor</th>
            </tr>
          </thead>
          <tbody>
            {cronograma.map((pago) => (
              <tr>
                <td class="border border-gray-300 px-4 py-2">{pago.mes}</td>
                <td class="border border-gray-300 px-4 py-2">{pago.cuota.toFixed(2)}</td>
                <td class="border border-gray-300 px-4 py-2">{pago.interes.toFixed(2)}</td>
                <td class="border border-gray-300 px-4 py-2">{pago.amortizacion.toFixed(2)}</td>
                <td class="border border-gray-300 px-4 py-2">{pago.saldoDeudor.toFixed(2)}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <div class="mt-4">
          <p><strong>VAN:</strong> {indicadores.van.toFixed(2)}</p>
          <p><strong>TIR:</strong> {(indicadores.tir * 100).toFixed(2)}%</p>
        </div>
      </div>
    </div>
  </body>
</html>
