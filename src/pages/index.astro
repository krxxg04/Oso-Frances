---
import Layout from '../layouts/Layout.astro';
import SimuladorCredito from '../components/SimuladorCredito.astro';
---

<Layout title="Crédito Vehicular">
  <main class="mx-auto w-full max-w-3xl px-4 py-8">
    <header class="flex items-center gap-3">
      <img
        src="/Whiteosito.png"
        alt="Oso Francés"
        class="h-10 w-10 rounded-lg border border-blue-100 bg-white"
        loading="eager"
      />
      <div class="leading-tight">
        <p class="text-xs font-medium text-blue-700">El Oso Francés</p>
        <h1 class="text-lg font-semibold tracking-tight text-slate-900">
          Sistema de Crédito Vehicular (Compra Inteligente)
        </h1>
        <p class="mt-0.5 text-xs text-slate-500">Método Francés · Client-side · Persistencia en el navegador</p>
      </div>
    </header>

    <section class="mt-6">
      <SimuladorCredito />
    </section>
  </main>
</Layout>

<script>
  import { requireAuthOrRedirect } from '../scripts/auth';
  requireAuthOrRedirect();
</script>