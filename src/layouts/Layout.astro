---
import '../styles/global.css';
const { title } = Astro.props;
---
	<!doctype html>
	<html lang="es">
		<head>
			<meta charset="UTF-8" />
			<meta name="viewport" content="width=device-width" />
			<link rel="icon" type="image/png" href="/Whiteosito.png" />
			<link rel="apple-touch-icon" href="/Whiteosito.png" />
			<meta name="generator" content={Astro.generator} />
			<title>{title ? `${title} · Oso Frances` : 'Oso Frances'}</title>
		</head>
		<body class="min-h-screen bg-blue-50 text-slate-900 font-sans antialiased">
			<slot />
		</body>
	</html>

	<style>
		html,
		body {
			margin: 0;
			width: 100%;
			height: 100%;
		}
	</style>
